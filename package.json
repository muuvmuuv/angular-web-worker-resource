{
	"name": "angular-web-worker-resource-workspace",
	"version": "22.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "pnpm --filter=angular-web-worker-resource build",
		"watch": "pnpm --filter=angular-web-worker-resource watch",
		"test": "pnpm --filter=angular-web-worker-resource test",
		"test:watch": "pnpm --filter=angular-web-worker-resource test:watch",
		"serve": "pnpm --filter=app serve",
		"serve-extended": "pnpm --filter=app serve-extended",
		"build-app": "pnpm --filter=app build",
		"check": "oxlint . && oxfmt --check .",
		"format": "oxlint --fix . && oxfmt .",
		"release": "release-it"
	},
	"devDependencies": {
		"@angular-devkit/core": "^22.3.0",
		"@angular/build": "^22.3.0",
		"@angular/cli": "^22.3.0",
		"@angular/compiler-cli": "^22.3.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-angular": "^21.2.4",
		"@release-it/bumper": "^8.0.1",
		"@types/node": "^24.19.2",
		"del-cli": "^8.0.1",
		"lefthook": "^2.2.2",
		"ng-packagr": "^22.3.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"release-it": "^21.1.2",
		"tsrs": "7.1.0-beta.tsrs2",
		"typescript": "6.0.3",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=24"
	}
}
